
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Venue {
  id      String  @id @default(uuid()) @db.Uuid
  name    String
  city    String
  address String
  events  Event[]

  @@index([city])
}

model Event {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  startsAt    DateTime @map("starts_at")
  venueId     String   @map("venue_id") @db.Uuid
  organizerId String? @db.Uuid
  organizer User? @relation("OrganizedEvents", fields: [organizerId], references: [id], onDelete: SetNull)
  
  venue Venue  @relation(fields: [venueId], references: [id])
  seats Seat[]
  
  
  @@index([startsAt, id])
  @@index([venueId])
  @@index([organizerId])
}

model Seat {
  id      String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  row     Int
  number  Int
  status  String @default("available")

  event Event @relation(fields: [eventId], references: [id])

  @@unique([eventId, row, number])
  @@index([eventId])
}


enum Role {
  USER
  ORGANIZER
  ADMIN
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  emailVerified Boolean @default(false)
  oauthAccounts OAuthAccount[]
  organizedEvents Event[] @relation("OrganizedEvents")

  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
}


model OAuthAccount {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  provider        String
  providerSubject String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
}
